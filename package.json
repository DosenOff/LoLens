{
  "name": "lolens",
  "version": "0.1.0",
  "description": "Real-time League draft intelligence app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder",
    "test-lcu": "node scripts/test-lcu.js",
    "fetch-champion-data": "node scripts/fetch-champion-data.js",
    "fetch-match-ids": "node --env-file=.env scripts/fetch-match-ids.js",
    "fetch-match-details": "node --env-file=.env scripts/fetch-match-details.js",
    "fetch-population-data": "node --env-file=.env scripts/fetch-population-data.js",
    "test-champselect": "node scripts/test-champselect.js"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.shawnlee.lolens",
    "productName": "LoLens",
    "afterPack": "scripts/afterPack.js",
    "files": [
      "main.js",
      "preload.js",
      "overlay-preload.js",
      "lib/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!data/**/*",
      "data/population-stats.json",
      "!.env",
      "!.env.example",
      "!scripts/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon/icon-mark.png",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "LoLens-macOS-arm64.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon/icon.ico",
      "artifactName": "LoLens-Windows.${ext}"
    }
  },
  "allowScripts": {
    "electron@32.3.3": true
  }
}
