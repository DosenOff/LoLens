# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit your actual API key.

RIOT_API_KEY=your-key-here
RIOT_GAME_NAME=Dosen
RIOT_TAG_LINE=NA0

# One of: americas, europe, asia
RIOT_REGION=americas

# Platform for league-v4/summoner-v4 calls (different routing than RIOT_REGION above)
# One of: na1, euw1, eun1, kr, jp1, br1, la1, la2, oc1, tr1, ru
RIOT_PLATFORM=na1

# How many recent match IDs to fetch (Riot allows up to 100 per request)
MATCH_COUNT=100

# Population baseline sampling (fetch-population-data.js)
POP_PLAYERS_PER_TIER=50
POP_GAMES_PER_PLAYER=5